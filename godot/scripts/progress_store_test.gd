extends SceneTree
var failures = 0
const Store = preload("res://scripts/progress_store.gd")
func _initialize() -> void: call_deferred("run")
func check(ok: bool, text: String) -> void:
	if ok: print("PASS: ", text)
	else:
		failures += 1
		push_error("FAIL: " + text)
func run() -> void:
	var path = "/tmp/guangong-store-%d.cfg" % Time.get_ticks_usec()
	var store = Store.new()
	store.load_file(path)
	check(store.intro_state() == "unseen" and store.completed_count() == 0 and store.best_score() == 0, "fresh store has safe journey defaults")
	check(store.is_unlocked("dongling") and not store.is_unlocked("luoyang") and not store.is_unlocked("invalid"), "fresh store unlocks only first known chapter")
	store.config.set_value("old_score_version", "best", 321)
	store.config.set_value("custom", "note", "preserve")
	store.set_intro("skipped")
	check(store.save_preferences(true, true, 456), "settings and intro save together")
	var reload = Store.new()
	reload.load_file(path)
	check(reload.intro_state() == "skipped" and reload.muted() and reload.reduced_motion(), "intro and preferences survive reload")
	check(reload.config.get_value("custom", "note") == "preserve" and reload.config.get_value("old_score_version", "best") == 321, "unrelated and old scoring fields survive save")
	reload.mark_cleared("dongling", 900)
	reload.save_preferences(false, false, 700)
	check(reload.is_cleared("dongling") and reload.completed_count() == 1 and reload.best_score() == 900, "first completion persists with maximum score")
	check(reload.is_unlocked("luoyang") and not reload.is_unlocked("sishui"), "first completion unlocks only next prerequisite")
	reload.mark_cleared("dongling", 500)
	check(reload.completed_count() == 1 and reload.best_score() == 900, "repeated low score cannot duplicate completion or reduce best")
	var before = reload.completed_count()
	reload.mark_cleared("unknown", 99999)
	check(before == reload.completed_count() and reload.best_score() == 900, "unknown chapter cannot create progress or score")
	for id in ["luoyang", "sishui", "xingyang", "yellow_river"]:
		check(reload.is_unlocked(id), "sequential prerequisite opens " + id)
		reload.mark_cleared(id, 1)
	check(reload.completed_count() == 5, "all distinct chapter completions count once")
	var legacy_path = "/tmp/guangong-legacy-%d.cfg" % Time.get_ticks_usec()
	var legacy = ConfigFile.new()
	legacy.set_value(Store.SCORE_VERSION, "cleared", true)
	legacy.set_value(Store.SCORE_VERSION, "best", 987)
	legacy.set_value("settings", "muted", true)
	legacy.set_value("old", "best", 432)
	legacy.save(legacy_path)
	var migrated = Store.new()
	migrated.load_file(legacy_path)
	check(migrated.needs_migration and migrated.intro_state() == "legacy" and migrated.is_cleared("dongling"), "legacy completion migrates without claiming animation watched")
	check(migrated.best_score() == 987 and migrated.muted() and migrated.config.get_value("old", "best") == 432, "migration retains versioned records and sound")
	migrated.save_file()
	var again = Store.new()
	again.load_file(legacy_path)
	check(not again.needs_migration and again.completed_count() == 1, "migration is idempotent")
	var settings_path = "/tmp/guangong-settings-%d.cfg" % Time.get_ticks_usec()
	legacy = ConfigFile.new()
	legacy.set_value("settings", "muted", true)
	legacy.save(settings_path)
	again.load_file(settings_path)
	check(again.intro_state() == "unseen", "sound preference alone is not proof of viewing intro")
	var future_path = "/tmp/guangong-future-%d.cfg" % Time.get_ticks_usec()
	legacy.set_value("journey", "schema_version", 99)
	legacy.save(future_path)
	var original = FileAccess.get_file_as_bytes(future_path)
	again.load_file(future_path)
	check(not again.writable and not again.save_preferences(false, false, 0) and FileAccess.get_file_as_bytes(future_path) == original, "unsupported version is not overwritten")
	check(not again.error_text.is_empty(), "unsupported version has visible explanation")
	var failure = Store.new()
	failure.load_file("/tmp/guangong-missing-parent-%d/progress.cfg" % Time.get_ticks_usec())
	check(not failure.save_preferences(false, false, 0) and failure.error_text == "本次进度未能保存", "write failure is reported without pretending success")
	print("PROGRESS CHECKS COMPLETE; failures=", failures)
	quit(1 if failures else 0)
